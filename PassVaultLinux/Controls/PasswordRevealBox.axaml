<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PassVaultLinux.Controls.PasswordRevealBox">
    <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="Box" Grid.Column="0" PasswordChar="•" TextChanged="Box_TextChanged" />
        <Button x:Name="ToggleButton" Grid.Column="1" Content="Show" Classes="secondary" Click="ToggleButton_Click" Margin="4,0,0,0" VerticalAlignment="Center" />
    </Grid>
</UserControl>
