<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PassVaultLinux.Views.HiddenPasswordsView">
    <Grid Background="{DynamicResource WindowBackgroundBrush}" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Content="&#8592;" Classes="icon" Click="Back_Click" />
                <TextBlock Grid.Column="1" Text="Secret passwords" Classes="headline" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="+" Classes="icon" Click="Add_Click" ToolTip.Tip="Add password" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <TextBlock x:Name="EmptyText" Classes="secondary" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32" IsVisible="False"
                       Text="Nothing here yet. Tap + to add a secret password." />
            <ListBox x:Name="CredentialsList" Background="Transparent" SelectionChanged="CredentialsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8,6">
                            <TextBlock Text="{Binding Title}" FontSize="14" />
                            <TextBlock Text="{Binding Username}" Classes="secondary" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
