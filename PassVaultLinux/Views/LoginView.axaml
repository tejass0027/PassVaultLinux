<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PassVaultLinux.Controls"
             x:Class="PassVaultLinux.Views.LoginView">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Margin="32">
            <TextBlock Text="PassVault" Classes="headline" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock x:Name="StatusText" Classes="secondary" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24" />

            <controls:PatternLockControl x:Name="PatternControl" Width="280" Height="280" HorizontalAlignment="Center" />
            <Button Content="Forgot pattern?" Classes="secondary" Click="ForgotPattern_Click" Margin="0,20,0,0" />

            <ProgressBar x:Name="VerifyingProgress" IsIndeterminate="True" Width="200" Height="4" IsVisible="False" Margin="0,12,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
