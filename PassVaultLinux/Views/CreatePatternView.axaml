<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PassVaultLinux.Controls"
             x:Class="PassVaultLinux.Views.CreatePatternView">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel VerticalAlignment="Center" Margin="32">
            <TextBlock x:Name="TitleText" Classes="headline" FontSize="20" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock x:Name="SubtitleText" Classes="secondary" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,32" />
            <controls:PatternLockControl x:Name="PatternControl" Width="300" Height="300" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
