<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PassVaultLinux.Views.HiddenNotesView">
    <Grid Background="{DynamicResource WindowBackgroundBrush}" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Content="&#8592;" Classes="icon" Click="Back_Click" />
                <TextBlock Grid.Column="1" Text="Secret notes" Classes="headline" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="+" Classes="icon" Click="Add_Click" ToolTip.Tip="Add note" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <StackPanel x:Name="ListPanel">
                <TextBlock x:Name="EmptyText" Classes="secondary" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="32" IsVisible="False"
                           Text="Nothing here yet. Tap + to add a secret note." />
                <ListBox x:Name="NotesList" Background="Transparent" SelectionChanged="NotesList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Margin="8,6">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}" FontSize="14" />
                                    <TextBlock Text="{Binding Preview}" Classes="secondary" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="&#128465;" Classes="icon" Click="DeleteNote_Click" Tag="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <StackPanel x:Name="EditorPanel" Margin="24" IsVisible="False">
                <TextBlock Text="Title" Margin="0,0,0,4" />
                <TextBox x:Name="EditTitleBox" Margin="0,0,0,16" />
                <TextBlock Text="Secret" Margin="0,0,0,4" />
                <TextBox x:Name="EditContentBox" Height="240" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,16" />
                <Button Content="Save" Classes="primary" Click="SaveNote_Click" Margin="0,0,0,8" />
                <Button Content="Cancel" Classes="secondary" Click="CancelEdit_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
