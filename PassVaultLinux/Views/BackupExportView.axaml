<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PassVaultLinux.Controls"
             x:Class="PassVaultLinux.Views.BackupExportView">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel VerticalAlignment="Center" MaxWidth="380" Margin="32">
            <TextBlock Text="Export encrypted backup" Classes="headline" FontSize="20" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Classes="secondary" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,24"
                       Text="Choose a password for this backup file. You'll need it to restore the backup later, so don't lose it - it's separate from your pattern." />

            <TextBlock Text="Backup password" Margin="0,0,0,4" />
            <controls:PasswordRevealBox x:Name="PasswordBox" Margin="0,0,0,12" />
            <TextBlock Text="Confirm password" Margin="0,0,0,4" />
            <controls:PasswordRevealBox x:Name="ConfirmPasswordBox" Margin="0,0,0,16" />

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" TextAlignment="Center" IsVisible="False" Margin="0,0,0,12" />
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" IsVisible="False" Margin="0,0,0,12" />

            <Button x:Name="SaveButton" Content="Choose location and save" Classes="primary" Click="Save_Click" />
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="4" IsVisible="False" Margin="0,12,0,0" />

            <Button Content="Done" Classes="secondary" Click="Done_Click" Margin="0,8,0,0" />
            <Button Content="Cancel" Classes="secondary" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</UserControl>
